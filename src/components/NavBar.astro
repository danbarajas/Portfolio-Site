---
import { links } from '../vars';
---

<nav class="fixed w-full z-50 text-white px-6 py-4 text-2xl font-bold backdrop-blur-xs drop-shadow-2xl">
    <div class="flex items-center justify-between">
        <h1 class="basis-1/2">Daniel Barajas</h1>

        {links.map((link) => (
        <a
            id={link.id}
            class="transition-colors duration-200 hover:text-red-500 cursor-pointer"
        >
            {link.name}
        </a>
        ))}
    </div>
</nav>