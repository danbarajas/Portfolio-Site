---
import Tab from '../layouts/Tab.astro';
import ContactForm from './ContactForm.jsx';
---

<Tab id="contactTab">
    <div class="grid grid-cols-3 grid-rows-5 w-1/2 gap-5">
        <ContactForm client:load />
        <a href="https://drive.google.com/file/d/1EFIBSgG7TiBcCf4Sa3F0sSIUVkHn2b8u/view?usp=sharing" target="_blank" class="flex items-center justify-center rounded-3xl text-2xl font-bold bg-(--primary-light-muted) text-(--background-light) select-none cursor-pointer hover:shadow-[0_2px_5px_2px] shadow-(color:--primary-light)/60 hover:scale-105 hover:-translate-y-px transition-all">
            Resume
        </a>
        <a href="https://github.com/danbarajas" target="_blank" class="flex items-center justify-center rounded-3xl text-2xl font-bold bg-[#232925] text-[#F2F5F3] select-none cursor-pointer hover:shadow-[0_2px_5px_2px] shadow-[#232925]/60 hover:scale-105 hover:-translate-y-px transition-all">
            GitHub
        </a>
        <a href="https://linkedin.com/in/danbarajas" target="_blank" class="flex items-center justify-center rounded-3xl text-2xl font-bold bg-[#0b66c3] text-[#fefefe] select-none cursor-pointer hover:shadow-[0_2px_5px_2px] shadow-[#0b66c3]/60 hover:scale-105 hover:-translate-y-px transition-all">
            LinkedIn                
        </a>
    </div>
</Tab>