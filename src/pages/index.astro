---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';
---

<Layout>
	<NavBar />
	<main id="main" class="h-screen overflow-x-hidden perspective-[1px] transform-3d scroll-smooth no-scrollbar snap-y snap-proximity">
		<Hero />

		<div id="tabs" class="grid grid-flow-col h-screen transform-3d overflow-x-scroll no-scrollbar snap-center snap-x snap-mandatory scroll-smooth">
			<About />
			<Projects />
			<Contact />
		</div>
	</main>
</Layout>